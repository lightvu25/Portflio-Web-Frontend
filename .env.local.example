# Copy to .env.local and adjust. Never put backend secrets here
# (no JWT_SECRET, CLOUDINARY_API_SECRET, TURNSTILE_SECRET_KEY,
# DATABASE_URL, or bank credentials).

# Backend REST API base URL (Spring Boot).
NEXT_API_URL=http://localhost:8080

# Cloudflare Turnstile PUBLIC site key — REQUIRED in production (Vercel):
# read server-side on the booking page and passed to the widget; without it
# a production deployment BLOCKS booking submission rather than sending a
# placeholder token. This is a public key, safe to expose — no NEXT_PUBLIC_
# prefix needed since it never ships to the browser as a raw env lookup.
# The matching secret stays server-side in the backend only.
# Leave unset in local dev to bypass CAPTCHA (backend: TURNSTILE_ENABLED=false).
# TURNSTILE_SITE_KEY=
